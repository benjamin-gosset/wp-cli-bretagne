{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "extraLibraries": [
    "wp-cli"
  ],
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "atelier-wp-cli-2026"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "La Maison des Contributeurs",
        "blogdescription": "Atelier pratique WP-CLI",
        "timezone_string": "Europe/Paris",
        "date_format": "d/m/Y",
        "time_format": "H:i"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/plugins",
      "filesTree": {
        "resource": "literal:directory",
        "name": "atelier-incident",
        "files": {
          "atelier-incident.php": "<?php\n/**\n * Plugin Name: Atelier Incident\n * Description: Plugin volontairement défectueux pour l'atelier WP-CLI.\n * Version: 1.0.0\n */\nif ( get_option( 'atelier_incident_enabled', '0' ) === '1' ) {\n    throw new RuntimeException('Incident WP-CLI : le plugin Atelier Incident provoque volontairement une erreur.');\n}\n"
        }
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/plugins",
      "filesTree": {
        "resource": "literal:directory",
        "name": "atelier-cpt",
        "files": {
          "atelier-cpt.php": "<?php\n/**\n * Plugin Name: Atelier CPT\n * Description: Enregistre un type de contenu Livre et une taxonomie Genre pour le TP6.\n * Version: 1.0.0\n */\nadd_action( 'init', function () {\n    register_post_type( 'livre', array(\n        'labels'       => array( 'name' => 'Livres', 'singular_name' => 'Livre' ),\n        'public'       => true,\n        'has_archive'  => true,\n        'show_in_rest' => true,\n        'menu_icon'    => 'dashicons-book',\n        'supports'     => array( 'title', 'editor', 'excerpt', 'custom-fields' ),\n        'rewrite'      => array( 'slug' => 'livres' ),\n    ) );\n    register_taxonomy( 'genre', 'livre', array(\n        'labels'       => array( 'name' => 'Genres', 'singular_name' => 'Genre' ),\n        'public'       => true,\n        'hierarchical' => true,\n        'show_in_rest' => true,\n    ) );\n} );\n"
        }
      }
    },
    {
      "step": "wp-cli",
      "command": "wp plugin activate atelier-cpt"
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/plugins",
      "filesTree": {
        "resource": "literal:directory",
        "name": "atelier-accueil",
        "files": {
          "atelier-accueil.php": "<?php\n/**\n * Plugin Name: Atelier Accueil\n * Description: Crée une page d'accueil de démonstration (sans image, autonome) et la définit comme page statique. Pour l'atelier WP-CLI.\n * Version: 1.1.0\n */\n\nadd_action( 'init', function () {\n\n    // Idempotence : ne rien faire si la page existe déjà.\n    if ( get_option( 'atelier_accueil_done' ) === '1' ) {\n        return;\n    }\n\n    $contenu = <<<'HTML'\n<!-- wp:cover {\"dimRatio\":100,\"customOverlayColor\":\"#13202b\",\"isUserOverlayColor\":true,\"minHeight\":70,\"minHeightUnit\":\"vh\",\"align\":\"full\"} -->\n<div class=\"wp-block-cover alignfull\" style=\"min-height:70vh\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-100 has-background-dim\" style=\"background-color:#13202b\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"textAlign\":\"center\",\"level\":1,\"textColor\":\"white\",\"fontSize\":\"xx-large\"} -->\n<h1 class=\"wp-block-heading has-text-align-center has-white-color has-text-color has-xx-large-font-size\">La Maison des Contributeurs</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"white\",\"fontSize\":\"large\"} -->\n<p class=\"has-text-align-center has-white-color has-text-color has-large-font-size\">Un site de démonstration pour apprendre à gérer WordPress depuis le terminal, avec WP-CLI.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#atelier\">Découvrir l'atelier</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:spacer {\"height\":\"48px\"} -->\n<div style=\"height:48px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:heading {\"textAlign\":\"center\",\"anchor\":\"atelier\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|70\"}}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\" id=\"atelier\" style=\"margin-bottom:var(--wp--preset--spacing--70)\">Ce que vous apprendrez</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|70\"}}}} -->\n<div class=\"wp-block-columns alignwide\" style=\"margin-bottom:var(--wp--preset--spacing--70)\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Observer</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Dresser l'état d'un site — version, extensions, utilisateurs — sans ouvrir le back-office.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Maintenir</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Mettre à jour, diagnostiquer un incident et reprendre la main en ligne de commande.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Automatiser</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Transformer les tâches répétitives en procédures reproductibles : scripts, cron, migrations.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"}}},\"backgroundColor\":\"black\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-black-background-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"textAlign\":\"center\",\"textColor\":\"white\"} -->\n<h2 class=\"wp-block-heading has-text-align-center has-white-color has-text-color\">Prêt à ouvrir le terminal ?</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"white\"} -->\n<p class=\"has-text-align-center has-white-color has-text-color\">Le kit complet de l'atelier est disponible sur le dépôt du projet.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/benjamin-gosset/wp-cli-bretagne\">Voir le dépôt</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"align\":\"wide\"} -->\n<h2 class=\"wp-block-heading alignwide\">Derniers articles</h2>\n<!-- /wp:heading -->\n\n<!-- wp:query {\"queryId\":10,\"query\":{\"perPage\":6,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"inherit\":false},\"align\":\"wide\"} -->\n<div class=\"wp-block-query alignwide\"><!-- wp:post-template {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":3}} -->\n<!-- wp:post-date /-->\n<!-- wp:post-title {\"level\":3,\"isLink\":true} /-->\n<!-- /wp:post-template -->\n\n<!-- wp:query-no-results -->\n<!-- wp:paragraph -->\n<p>Aucun article pour le moment.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:query-no-results --></div>\n<!-- /wp:query --></div>\n<!-- /wp:group -->\nHTML;\n\n    $page_id = wp_insert_post( array(\n        'post_title'   => 'Accueil',\n        'post_name'    => 'accueil',\n        'post_content' => $contenu,\n        'post_status'  => 'publish',\n        'post_type'    => 'page',\n    ) );\n\n    if ( $page_id && ! is_wp_error( $page_id ) ) {\n        update_option( 'show_on_front', 'page' );\n        update_option( 'page_on_front', $page_id );\n        // Tentative d'assignation du template sans titre. Le nom exact dépend du thème actif :\n        // Twenty Twenty-Four expose \"page-no-title\". Si le thème ne le connaît pas, l'attribut est ignoré.\n        update_post_meta( $page_id, '_wp_page_template', 'page-no-title' );\n        update_option( 'atelier_accueil_done', '1' );\n    }\n} );\n"
        }
      }
    },
    {
      "step": "wp-cli",
      "command": "wp plugin activate atelier-accueil"
    },
    {
